services:
  gluetun:
    image: {{ gluetun_image }}
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=cyberghost
      - VPN_TYPE=openvpn
      - OPENVPN_USER=${OPENVPN_USER}
      - OPENVPN_PASSWORD=${OPENVPN_PASSWORD}
      - SERVER_COUNTRIES=${SERVER_COUNTRIES}
      - TZ=${TZ}
      # Allow traffic to/from the shared docker network so Glance can health-check the
      # qBittorrent WebUI by name. Docker-local only — internet-bound torrent traffic
      # still has no route except the tunnel, so the kill-switch is unaffected.
      - FIREWALL_OUTBOUND_SUBNETS={{ homelab_subnet }}
    ports:
      # qBittorrent's WebUI is published here rather than on the qbittorrent service:
      # that container has no network stack of its own (network_mode: service:gluetun),
      # so every port it listens on has to be declared by gluetun.
      - {{ qbittorrent_webui_port }}:8080   # qBittorrent WebUI — reached directly, own login
      - 6881:6881         # torrent TCP
      - 6881:6881/udp     # torrent UDP
    volumes:
      - ${APPDATA}/gluetun:/gluetun
    networks:
      - default
      - homelab                       # qBittorrent shares this namespace; lets Glance reach its WebUI
    labels:
      # Never auto-updated, for qBittorrent's sake rather than its own: qBittorrent runs in
      # this container's network namespace and is itself excluded below, so a Watchtower
      # recreate here would leave it with a dead netns and no route out. The two only ever
      # move together — see the "Recreate VPN containers" handler. Bump gluetun_image by hand.
      - com.centurylinklabs.watchtower.enable=false
    restart: unless-stopped

  qbittorrent:
    image: {{ qbittorrent_image }}
    container_name: qbittorrent
    network_mode: "service:gluetun"     # ALL qBittorrent traffic routes through the VPN
    depends_on:
      gluetun:
        condition: service_healthy
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - WEBUI_PORT=8080
    volumes:
      - ${APPDATA}/qbittorrent:/config
      - ${MEDIA}:/data                   # whole /data mounted so hardlinks work later
    labels:
      # Never auto-updated. qBittorrent holds its entire torrent list as local state under
      # /config/qBittorrent/BT_backup, and a recreate across a config-schema migration can
      # drop it. The data then stays on /data with nothing left referencing it, so no cleanup
      # can ever reclaim it: the likeliest cause of the 481 GB of orphans found in Sep 2026.
      # Bump qbittorrent_image by hand, and check the torrent list is still there afterwards.
      - com.centurylinklabs.watchtower.enable=false
    restart: unless-stopped

  prowlarr:
    image: {{ prowlarr_image }}
    container_name: prowlarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ${APPDATA}/prowlarr:/config
    ports:
      - 9696:9696
    networks:
      - default
      - homelab                       # shared network: Uptime Kuma probes it by container name
    restart: unless-stopped

  sonarr:
    image: {{ sonarr_image }}
    container_name: sonarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ${APPDATA}/sonarr:/config
      - ${MEDIA}:/data
    ports:
      - 8989:8989
    networks:
      - default
      - homelab                       # shared network: Uptime Kuma probes it by container name
    restart: unless-stopped

  radarr:
    image: {{ radarr_image }}
    container_name: radarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ${APPDATA}/radarr:/config
      - ${MEDIA}:/data
    ports:
      - 7878:7878
    networks:
      - default
      - homelab                       # shared network: Uptime Kuma probes it by container name
    restart: unless-stopped

  bazarr:
    image: {{ bazarr_image }}
    container_name: bazarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ${APPDATA}/bazarr:/config
      - ${MEDIA}:/data
    ports:
      - 6767:6767
    networks:
      - default
      - homelab                       # shared network: Uptime Kuma probes it by container name
    restart: unless-stopped

  recyclarr:
    image: {{ recyclarr_image }}
    container_name: recyclarr
    user: "${PUID}:${PGID}"           # image is rootless; PUID/PGID env are NOT supported — set the uid here
    depends_on:
      - sonarr                        # ordering only; recyclarr retries on its cron if they're not up yet
      - radarr
    environment:
      - TZ=${TZ}
      - CRON_SCHEDULE=${RECYCLARR_CRON}
      - SONARR_API_KEY=${SONARR_API_KEY}   # referenced as !env_var in recyclarr.yml
      - RADARR_API_KEY=${RADARR_API_KEY}
    volumes:
      - ${APPDATA}/recyclarr:/config
    restart: unless-stopped

  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - DOCKER_MODS=linuxserver/mods:jellyfin-opencl-intel   # Intel OpenCL runtime — GPU tone mapping (HDR→SDR)
    group_add:
      - "{{ jellyfin_render_gid }}"   # render — Quick Sync (renderD128)
      - "{{ jellyfin_video_gid }}"    # video
    devices:
      - /dev/dri:/dev/dri
    ports:
      - 8096:8096                     # stays published: TV/phone clients hit Jellyfin directly
    volumes:
      - ${APPDATA}/jellyfin:/config
      - ${MEDIA}/media:/data/media
    networks:
      - default                       # the media-stack project network (the *arr apps, gluetun)
      - homelab                       # + the shared network, where the monitoring stack lives
    restart: unless-stopped

  seerr:
    image: {{ seerr_image }}
    container_name: seerr
    init: true                        # required by Seerr (runs as non-root node user, UID 1000)
    environment:
      - TZ=${TZ}
    ports:
      - 5055:5055
    volumes:
      - ${APPDATA}/seerr:/app/config
    restart: unless-stopped

  maintainerr:
    image: {{ maintainerr_image }}
    container_name: maintainerr
    environment:
      - TZ=${TZ}
    volumes:
      - ${APPDATA}/maintainerr:/opt/data
    ports:
      - 6246:6246
    networks:
      - default
      - homelab                       # shared network: Uptime Kuma probes it by container name
    restart: unless-stopped

  npm:
    image: {{ npm_image }}
    container_name: npm
    ports:
      - 80:80         # http (where all *.home traffic lands)
      - 443:443       # https (unused for now, reserved)
      - 81:81         # NPM admin UI
    volumes:
      - ${APPDATA}/npm/data:/data
      - ${APPDATA}/npm/letsencrypt:/etc/letsencrypt
    networks:
      - default                       # reaches sonarr/radarr/gluetun/... by container name
      - homelab                       # + the shared network, for the remaining *.home proxy hosts
    restart: unless-stopped

# Services omitting `networks:` join `default` implicitly. The ones listing `homelab`
# too are those the monitoring stack probes by container name across compose projects.
networks:
  default:
  homelab:
    external: true                    # created by the docker role, which runs first in site.yml
