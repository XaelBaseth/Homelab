services:
  adguard:
    image: {{ adguard_image }}
    container_name: adguard
    # Host networking: AdGuard is the LAN's DHCP server, and DHCP is broadcast — it can't
    # cross Docker's NAT. So no `ports:`; what it listens on lives in its own config
    # (conf/AdGuardHome.yaml, written by the UI): DNS :53 on 0.0.0.0 — safe, systemd-resolved
    # is inactive on this host and nothing else holds :53 — DHCP :67, admin UI :3000.
    # If :53 ever collides with a resolver stub, see the Runbook — never point the host at AdGuard.
    network_mode: host
    volumes:
      - {{ adguard_appdata }}/work:/opt/adguardhome/work
      - {{ adguard_appdata }}/conf:/opt/adguardhome/conf
    labels:
      # Never auto-updated. AdGuard is the only DNS and DHCP server of the whole house: a
      # Watchtower recreate cuts everyone's internet, and a bad image keeps it cut. Bump
      # adguard_image by hand, when you're home to check it. See the Runbook.
      - com.centurylinklabs.watchtower.enable=false
    restart: unless-stopped
