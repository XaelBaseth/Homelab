# Upstream's compose (github.com/hillaliy/LanGuard), adapted: pinned images, bind-mounted
# appdata instead of named volumes, frontend moved off 8080, and no Docker socket.
#
# Host networking + privileged, on backend and scanner: ARP discovery needs Layer 2 access
# to the LAN, which Docker's NAT hides. So no `ports:` and no homelab network — NPM and
# Glance reach it at {{ vault_beelink_host }}:{{ languard_frontend_port }}, like AdGuard.
#
# No /var/run/docker.sock on the scanner: upstream mounts it for the "Docker inventory"
# integration, which Beszel and Dozzle already cover. A socket is root on the host, even :ro.
x-languard-env: &languard-env
  # No TZ / TIME_ZONE: LanGuard stores naive timestamps (USE_TZ = False) in TIME_ZONE and
  # converts AdGuard's query times to UTC. Anything but UTC shifts every query before the
  # device that made it, and DNS activity stays empty. Display timezone: Settings > Regional.
  # Hosts the backend answers to. 127.0.0.1 is required: the health check uses it.
  ALLOWED_HOSTS: {{ vault_beelink_host }},languard.{{ local_domain }},127.0.0.1
  CSRF_TRUSTED_ORIGINS: http://languard.{{ local_domain }},http://{{ vault_beelink_host }}:{{ languard_frontend_port }}
  DB_PATH: /data/db.sqlite3
  STATIC_ROOT: /static
  IP_RANGE: {{ languard_ip_range }}   # first-start default only; then Settings > Scanning
  # ENVIRONMENT stays unset (development) on purpose: "production" turns on Secure cookies,
  # and the browser drops them over plain HTTP — login would fail. DEBUG is off either way.

services:
  backend:
    image: {{ languard_backend_image }}
    container_name: languard-backend
    privileged: true
    network_mode: host
    env_file:
      - .env                          # SECRET_KEY, shared with the scanner
    environment:
      <<: *languard-env
      BACKEND_LISTEN_PORT: "{{ languard_backend_port }}"
    volumes:
      - {{ languard_appdata }}/data:/data
      - {{ languard_appdata }}/static:/static
      - ./resolv.conf:/etc/resolv.conf:ro   # device names from AdGuard's DHCP leases (see the file)
    healthcheck:
      test: ["CMD", "python", "-c", "import os, urllib.request; port = os.environ.get('BACKEND_LISTEN_PORT', '8000'); urllib.request.urlopen(f'http://127.0.0.1:{port}/api/v1/health/', timeout=3).read()"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 60s
    labels:
      # The three images must stay on the same release: bump languard_version by hand.
      - com.centurylinklabs.watchtower.enable=false
      - glance.name=LanGuard API
      - glance.icon=http://languard.{{ local_domain }}/logo.svg
      - glance.description=LanGuard backend
    restart: unless-stopped

  scanner:
    image: {{ languard_scheduler_image }}
    container_name: languard-scanner
    privileged: true
    network_mode: host
    command: ["python", "-u", "manage.py", "run_scheduler", "--run-now"]
    env_file:
      - .env
    environment:
      <<: *languard-env
    volumes:
      - {{ languard_appdata }}/data:/data
      - {{ languard_appdata }}/static:/static
      - ./resolv.conf:/etc/resolv.conf:ro
    labels:
      - com.centurylinklabs.watchtower.enable=false
      - glance.name=LanGuard scanner
      - glance.icon=http://languard.{{ local_domain }}/logo.svg
      - glance.description=ARP scans, AdGuard sync, alerts
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_healthy
        restart: true

  frontend:
    image: {{ languard_frontend_image }}
    container_name: languard-frontend
    network_mode: host                # not privileged: it only serves the UI and proxies /api
    environment:
      BACKEND_UPSTREAM: 127.0.0.1:{{ languard_backend_port }}
      FRONTEND_LISTEN_ADDRESS: ":{{ languard_frontend_port }}"
    labels:
      - com.centurylinklabs.watchtower.enable=false
      - glance.name=LanGuard
      - glance.icon=http://languard.{{ local_domain }}/logo.svg
      - glance.url=http://languard.{{ local_domain }}
      - glance.description=LAN devices + new-device alerts
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_healthy
        restart: true
