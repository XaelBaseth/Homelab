services:
  mealie:
    image: {{ mealie_image }}
    container_name: mealie
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - ALLOW_SIGNUP=false             # invite-only; nobody can self-register from the LAN
      - BASE_URL=http://{{ vault_beelink_host }}:{{ mealie_port }}   # used for links in notifications
    ports:
      - {{ mealie_port }}:9000
    volumes:
      - ${APPDATA}/mealie:/app/data    # SQLite db, recipe images, backups
    networks:
      - default
      - homelab                        # so NPM could reach it by name if this ever moves behind a proxy host
    deploy:
      resources:
        limits:
          memory: 1000M                # upstream's own recommendation — Mealie's workers grow unbounded otherwise
    labels:                            # Glance docker-containers widget presentation
      - glance.name=Mealie
      - glance.icon=di:mealie
      - glance.url=http://mealie.{{ local_domain }}
      - glance.description=Recipes and meal planning
    restart: unless-stopped

networks:
  default:
  homelab:
    external: true                     # created by the docker role, which runs first in site.yml
