services:
  mealie:
    image: {{ mealie_image }}
    container_name: mealie
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - ALLOW_SIGNUP=false             # invite-only; nobody can self-register from the LAN
      - BASE_URL=http://{{ vault_beelink_host }}:{{ mealie_port }}   # used for links in notifications
    ports:
      - {{ mealie_port }}:9000
    volumes:
      - ${APPDATA}/mealie:/app/data    # SQLite db, recipe images, backups
    networks:
      - default
      - homelab                        # so NPM could reach it by name if this ever moves behind a proxy host
    deploy:
      resources:
        limits:
          memory: 1000M                # upstream's own recommendation — Mealie's workers grow unbounded otherwise
    labels:                            # Glance docker-containers widget presentation
      - glance.name=Mealie
      - glance.icon=di:mealie
      - glance.url=http://mealie.{{ local_domain }}
      - glance.description=Recipes and meal planning
    restart: unless-stopped

  seshat:
    image: {{ seshat_image }}
    container_name: seshat
    pull_policy: never                 # local-only image (docker load); never look it up on Docker Hub
    user: "${PUID}:${PGID}"            # library files on the HDD stay owned by the media user
    environment:
      - TZ=${TZ}
      - MAX_UPLOAD_SIZE_MB={{ seshat_max_upload_mb }}
      - MAX_CONCURRENT_CONVERSIONS={{ seshat_max_concurrent_conversions }}
    volumes:
      - {{ seshat_library_path }}:/data/libraries   # books + SQLite dbs — the only thing to back up
    # No `ports:` on purpose — reached by name only, through NPM's seshat.home proxy host.
    networks:
      - default
      - homelab                        # NPM proxies seshat:8000; Glance / Uptime Kuma probe it by name
    deploy:
      resources:
        limits:
          memory: 1500M                # Calibre conversions of large books are the peak
    labels:
      - com.centurylinklabs.watchtower.enable=false   # local image, nothing to pull
      - glance.name=Seshat
      - glance.icon=http://seshat.{{ local_domain }}/favicon.svg   # our own emblem, served by Seshat itself
      - glance.url=http://seshat.{{ local_domain }}
      - glance.description=Ebook library, web reader + OPDS
    restart: unless-stopped

networks:
  default:
  homelab:
    external: true                     # created by the docker role, which runs first in site.yml
