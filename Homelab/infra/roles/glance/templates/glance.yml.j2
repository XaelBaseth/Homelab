server:
  assets-path: /app/assets   # served at /assets/ — holds custom.css

theme:
  custom-css-file: /assets/custom.css

pages:
  # ══ Page 1: Home — status, launcher, what's new ══════════════
  - name: Home
    columns:
      # ── Left: at-a-glance status ──
      - size: small
        widgets:
          - type: clock
            hour-format: 24h

          - type: weather
            location: Le Havre, France
            units: metric
            hour-format: 24h

          - type: server-stats
            servers:
              - type: local
                name: Beelink
                hide-mountpoints-by-default: false
                mountpoints:
                  /mnt/host/data:
                    name: Media
                  /mnt/host/home:
                    name: Apps

      # ── Center: launcher ──
      # Links use the *.home names: AdGuard is the LAN's DHCP server, so every device resolves
      # them. Each name is an NPM proxy host, spelled as NPM has it (qbit is short on purpose).
      # Every app still answers on IP:port too, if DNS is ever down.
      - size: full
        widgets:
          - type: split-column
            css-class: bookmarks-2col
            widgets:
              - type: bookmarks
                groups:
                  - title: Media
                    links:
                      - title: Jellyfin
                        url: http://jellyfin.{{ local_domain }}
                        icon: di:jellyfin
                      - title: Seerr
                        url: http://seerr.{{ local_domain }}
                        icon: di:seerr
                  # Ports are written out rather than templated: they are webapps role
                  # defaults, and role defaults are not in scope when playbooks/dashboard.yml
                  # runs this role on its own. Same reason the media ports above are literal.
                  - title: Apps
                    links:
                      - title: Mealie
                        url: http://mealie.{{ local_domain }}
                        icon: di:mealie
              - type: bookmarks
                groups:
                  - title: Monitoring
                    links:
                      - title: Uptime Kuma
                        url: http://uptime.{{ local_domain }}
                        icon: di:uptime-kuma
                      - title: Beszel
                        url: http://beszel.{{ local_domain }}
                        icon: di:beszel
                  - title: Administration
                    links:
                      - title: Dozzle
                        url: http://dozzle.{{ local_domain }}
                        icon: di:dozzle
                      - title: Dockge
                        url: http://dockge.{{ local_domain }}
                        icon: di:dockge
                      # Watchtower runs headless (notify-only) — no web UI, so no link
                  - title: Infra
                    links:
                      - title: Nginx Proxy Manager
                        url: http://npm.{{ local_domain }}
                        icon: di:nginx-proxy-manager
                      - title: AdGuard Home
                        url: http://adguard.{{ local_domain }}
                        icon: di:adguard-home

      # custom-api widgets call Jellyfin/Sonarr by container name over the homelab network;
      # the links they render use the *.home names, which the browser resolves. Their Go
      # templates are wrapped in Jinja raw blocks so Ansible leaves the Go braces alone.
      - size: small
        widgets:
{% if vault_jellyfin_api_key is defined and vault_jellyfin_api_key | length > 0 %}
          # In-progress films/episodes (Resume), then the next unwatched episode of each show
          # (Next Up), minus the ones already listed above.
          - type: custom-api
            title: Continue Watching
            cache: 5m
            url: http://jellyfin:8096/Users
            headers:
              Authorization: MediaBrowser Token="${JELLYFIN_API_KEY}"
            options:
              user-name: "{{ glance_jellyfin_user }}"
              public-url: http://jellyfin.{{ local_domain }}
            template: |
              {% raw %}{{ $user := .Options.StringOr "user-name" "" }}
              {{ $public := .Options.StringOr "public-url" "" }}
              {{ $auth := "MediaBrowser Token=\"${JELLYFIN_API_KEY}\"" }}
              {{ $uid := "" }}
              {{ range .JSON.Array "" }}
                {{ if and (eq $uid "") (or (eq $user "") (eq (.String "Name") $user)) }}{{ $uid = .String "Id" }}{{ end }}
              {{ end }}
              {{ if eq $uid "" }}
                <p class="color-negative">Jellyfin user "{{ $user }}" not found.</p>
              {{ else }}
                {{ $resume := newRequest "http://jellyfin:8096/UserItems/Resume" | withHeader "Authorization" $auth | withParameter "userId" $uid | withParameter "mediaTypes" "Video" | withParameter "limit" "8" | getResponse }}
                {{ $nextup := newRequest "http://jellyfin:8096/Shows/NextUp" | withHeader "Authorization" $auth | withParameter "userId" $uid | withParameter "limit" "8" | getResponse }}
                {{ $seen := "" }}
                <ul class="list list-gap-10 collapsible-container" data-collapse-after="5">
                {{ range $resume.JSON.Array "Items" }}
                  {{ $seen = concat $seen " " (.String "Id") }}
                  <li>
                    <a class="size-h4 color-highlight block text-truncate" href="{{ $public }}/web/#/details?id={{ .String "Id" }}" target="_blank" rel="noreferrer">{{ if eq (.String "Type") "Episode" }}{{ .String "SeriesName" }}{{ else }}{{ .String "Name" }}{{ end }}</a>
                    <div class="size-h6 text-truncate">{{ if eq (.String "Type") "Episode" }}{{ printf "S%02dE%02d" (.Int "ParentIndexNumber") (.Int "IndexNumber") }} · {{ .String "Name" }}{{ else }}Movie · {{ .Int "ProductionYear" }}{{ end }}</div>
                    <div class="progress-bar margin-top-5" style="height: 0.6rem"><div class="progress-value" style="--percent: {{ .Float "UserData.PlayedPercentage" }}"></div></div>
                  </li>
                {{ end }}
                {{ range $nextup.JSON.Array "Items" }}
                  {{ if not (findMatch (.String "Id") $seen) }}
                  <li>
                    <a class="size-h4 color-highlight block text-truncate" href="{{ $public }}/web/#/details?id={{ .String "Id" }}" target="_blank" rel="noreferrer">{{ .String "SeriesName" }}</a>
                    <div class="size-h6 text-truncate">Next: {{ printf "S%02dE%02d" (.Int "ParentIndexNumber") (.Int "IndexNumber") }} · {{ .String "Name" }}</div>
                  </li>
                  {{ end }}
                {{ else }}
                  {{ if eq $seen "" }}<li class="color-subdue">Nothing in progress.</li>{{ end }}
                {{ end }}
                </ul>
              {{ end }}{% endraw %}

{% endif %}
{% if vault_sonarr_api_key is defined and vault_sonarr_api_key | length > 0 %}
          # Episodes of monitored series airing in the next 30 days (Sonarr calendar).
          # Dates are shown in the container's TZ (set in docker-compose).
          - type: custom-api
            title: Upcoming Episodes
            cache: 1h
            options:
              public-url: http://sonarr.{{ local_domain }}
            template: |
              {% raw %}{{ $public := .Options.StringOr "public-url" "" }}
              {{ $cal := newRequest "http://sonarr:8989/api/v3/calendar" | withHeader "X-Api-Key" "${SONARR_API_KEY}" | withParameter "start" (now | startOfDay | formatTime "rfc3339") | withParameter "end" (offsetNow "720h" | formatTime "rfc3339") | withParameter "includeSeries" "true" | getResponse }}
              {{ if ne $cal.Response.StatusCode 200 }}
                <p class="color-negative">Sonarr answered {{ $cal.Response.StatusCode }}.</p>
              {{ else }}
                <ul class="list list-gap-10 collapsible-container" data-collapse-after="6">
                {{ range sortByTime "airDateUtc" "rfc3339" "asc" ($cal.JSON.Array "") }}
                  <li>
                    <div class="flex justify-between items-center gap-10">
                      <a class="size-h4 color-highlight text-truncate" href="{{ $public }}/series/{{ .String "series.titleSlug" }}" target="_blank" rel="noreferrer">{{ .String "series.title" }}</a>
                      <span class="shrink-0 size-h6">{{ (parseTime "rfc3339" (.String "airDateUtc")).Local | formatTime "02/01 15:04" }}</span>
                    </div>
                    <div class="size-h6 text-truncate">{{ printf "S%02dE%02d" (.Int "seasonNumber") (.Int "episodeNumber") }} · {{ .String "title" }}{{ if .Bool "hasFile" }} · <span class="color-positive">available</span>{{ end }}</div>
                  </li>
                {{ else }}
                  <li class="color-subdue">Nothing airing in the next 30 days.</li>
                {{ end }}
                </ul>
              {{ end }}{% endraw %}

{% endif %}
          - type: releases
            title: App Releases
            cache: 6h
{% if vault_github_token is defined and vault_github_token | length > 0 %}
            token: ${GLANCE_GITHUB_TOKEN}   # 5000 req/hr authenticated vs 60 unauthenticated
{% endif %}
            repositories:
              - jellyfin/jellyfin
              - seerr-team/seerr
              - Sonarr/Sonarr
              - Radarr/Radarr
              - Prowlarr/Prowlarr
              - morpheus65535/bazarr
              - recyclarr/recyclarr
              - jorenn92/Maintainerr        # adjust if the repo path 404s
              - qbittorrent/qBittorrent
              - qdm12/gluetun
              - louislam/uptime-kuma
              - henrygd/beszel
              - amir20/dozzle
              - louislam/dockge
              - nicholas-fedor/watchtower
              - glanceapp/glance
              - NginxProxyManager/nginx-proxy-manager
              - AdguardTeam/AdGuardHome
              - mealie-recipes/mealie

  # ══ Page 2: Tech — DevOps watch ══════════════════════════════
  # Every feed below was checked to answer with recent items. Left out: Reddit (429s
  # unauthenticated, from the server too), CERT-FR alerts (last one Jan 2024),
  # Last Week in AWS (idle since April), DevOps Weekly and KubeWeekly (no feed).
  # The collapse-after values are sized so the page fits one 1080p screen unexpanded.
  - name: Tech
    columns:
      - size: small
        widgets:
          - type: rss
            title: RudeOps Radar            # daily picks; the weekly newsletter is in the center column
            style: vertical-list
            single-line-titles: true
            cache: 1h
            limit: 15
            collapse-after: 5
            feeds:
              - url: https://www.rudeops.com/radar/feed.xml

          - type: lobsters
            tags:
              - devops
              - linux
              - security
            limit: 15
            collapse-after: 5

      # Each tab merges its feeds by date and keeps the newest `limit` items, so a daily
      # feed (LWN, Korben) would push a monthly one (Julia Evans) out entirely. Every feed
      # is capped at 6 and each tab's limit sits above the sum: all sources stay visible.
      - size: full
        widgets:
          - type: group
            widgets:
              - type: rss
                title: Newsletters
                style: detailed-list
                cache: 2h
                limit: 40
                collapse-after: 4
                feeds:
                  - url: https://www.rudeops.com/feed.xml
                    title: RudeOps
                    limit: 6
                  - url: https://sreweekly.com/feed/
                    title: SRE Weekly
                    limit: 6
                  - url: https://blog.pragmaticengineer.com/rss/
                    title: The Pragmatic Engineer
                    limit: 6
                  - url: https://blog.bytebytego.com/feed
                    title: ByteByteGo
                    limit: 6
                  - url: https://selfh.st/rss/
                    title: selfh.st
                    limit: 6

              - type: rss
                title: Cloud Native
                style: detailed-list
                cache: 2h
                limit: 40
                collapse-after: 4
                feeds:
                  - url: https://kubernetes.io/feed.xml
                    title: Kubernetes
                    limit: 6
                  - url: https://www.cncf.io/feed/
                    title: CNCF
                    limit: 6
                  - url: https://thenewstack.io/feed/
                    title: The New Stack
                    limit: 6
                  - url: https://www.docker.com/blog/feed/
                    title: Docker
                    limit: 6
                  - url: https://www.hashicorp.com/blog/feed.xml
                    title: HashiCorp
                    limit: 6
                  - url: https://github.blog/changelog/feed/
                    title: GitHub Changelog
                    limit: 6

              - type: rss
                title: Engineering
                style: detailed-list
                cache: 2h
                limit: 40
                collapse-after: 4
                feeds:
                  - url: https://blog.cloudflare.com/rss/
                    title: Cloudflare
                    limit: 6
                  - url: https://martinfowler.com/feed.atom
                    title: Martin Fowler
                    limit: 6
                  - url: https://jvns.ca/atom.xml
                    title: Julia Evans
                    limit: 6
                  - url: https://lwn.net/headlines/rss
                    title: LWN
                    limit: 6

              - type: rss
                title: FR
                style: detailed-list
                cache: 2h
                limit: 40
                collapse-after: 4
                feeds:
                  - url: https://www.journalduhacker.net/rss
                    title: Journal du hacker
                    limit: 6
                  - url: https://korben.info/feed
                    title: Korben
                    limit: 6
                  - url: https://blog.stephane-robert.info/index.xml
                    title: Stéphane Robert
                    limit: 6
                    headers:
                      # The site answers 403 to non-browser user agents
                      User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36

      - size: small
        widgets:
          - type: hacker-news
            limit: 15
            collapse-after: 7

  # ══ Page 3: Services — the application stack, health at a glance ══
  - name: Services
    columns:
      - size: full
        widgets:
          # url = the name you click; check-url = the IP:port Glance probes. Containers can't
          # resolve *.home (Docker forwards to the host's resolvers, Livebox + Quad9, never
          # AdGuard), so probing the names would show every service down.
          - type: monitor
            title: Media Stack
            cache: 1m
            sites:
              - title: Jellyfin
                url: http://jellyfin.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:8096
                icon: di:jellyfin
              - title: Seerr
                url: http://seerr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:5055
                icon: di:seerr
              - title: Sonarr
                url: http://sonarr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:8989
                icon: di:sonarr
              - title: Radarr
                url: http://radarr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:7878
                icon: di:radarr
              - title: Prowlarr
                url: http://prowlarr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:9696
                icon: di:prowlarr
              - title: Bazarr
                url: http://bazarr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:6767
                icon: di:bazarr
              - title: Maintainerr
                url: http://maintainerr.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:6246
                icon: di:maintainerr
              # Ports are written out rather than templated, same reason as page 1:
              # other roles' defaults are not in scope when dashboard.yml runs alone.
              - title: qBittorrent
                url: http://qbit.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:8080
                icon: di:qbittorrent

          - type: monitor
            title: Infrastructure
            cache: 1m
            sites:
              - title: Nginx Proxy Manager
                url: http://npm.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:81
                icon: di:nginx-proxy-manager
              - title: AdGuard Home
                url: http://adguard.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:3000
                icon: di:adguard-home
              - title: Uptime Kuma
                url: http://uptime.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:3001
                icon: di:uptime-kuma
              - title: Beszel
                url: http://beszel.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:8090
                icon: di:beszel

          - type: monitor
            title: Apps
            cache: 1m
            sites:
              - title: Mealie
                url: http://mealie.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:9925
                icon: di:mealie

          - type: monitor
            title: Administration
            cache: 1m
            sites:
              - title: Dozzle
                url: http://dozzle.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:8888
                icon: di:dozzle
              - title: Dockge
                url: http://dockge.{{ local_domain }}
                check-url: http://{{ vault_beelink_host }}:5001
                icon: di:dockge

  - name: Containers
    columns:
      - size: full
        widgets:
          # Live run-state of EVERY container (reads docker.sock :ro). This is where headless
          # Watchtower gets its dashboard presence; per-container display comes from glance.* labels.
          - type: docker-containers
            title: Containers
            cache: 30s
            hide-by-default: false
