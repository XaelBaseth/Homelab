GLANCE_GITHUB_TOKEN={{ vault_github_token | default('') }}
JELLYFIN_API_KEY={{ vault_jellyfin_api_key | default('') }}
SONARR_API_KEY={{ vault_sonarr_api_key | default('') }}
{# Single-quoted so Compose takes it literally: unquoted, a "$" in the password would be
   interpolated and a " #" would start a comment. A "'" would end the quoting, so it is
   written as its JSON unicode escape (backslash, u0027), which Beszel decodes back to
   the same password. #}
BESZEL_LOGIN='{{ {'identity': vault_beszel_user | default(''), 'password': vault_beszel_password | default('')} | to_json | replace("'", "\\u0027") }}'
