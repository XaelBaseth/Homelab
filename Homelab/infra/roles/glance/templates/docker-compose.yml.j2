services:
  glance:
    image: {{ glance_image }}
    container_name: glance
    env_file:
      - .env                        # GLANCE_GITHUB_TOKEN, JELLYFIN_API_KEY, SONARR_API_KEY, BESZEL_LOGIN
    environment:
      - TZ={{ timezone }}           # air dates in the Upcoming Episodes widget show in local time
    ports:
      - 8280:8080
    volumes:
      - ./config/glance.yml:/app/config/glance.yml
      - ./assets:/app/assets        # served at /assets/ (custom.css)
      # No host disk mounts: server stats come from Beszel's API, not from Glance itself.
      - /var/run/docker.sock:/var/run/docker.sock:ro   # docker-containers widget (live status of every container, incl. headless Watchtower)
    networks:
      - default
      - homelab                     # media-stack apps dropped their host ports; the monitor widget reaches them by container name
    restart: unless-stopped

networks:
  default:
  homelab:
    external: true
