services:
  lldap:
    image: {{ lldap_image }}
    container_name: lldap
    environment:
      - TZ=${TZ}
      - UID=${PUID}
      - GID=${PGID}
      - LLDAP_JWT_SECRET=${LLDAP_JWT_SECRET}
      - LLDAP_KEY_SEED=${LLDAP_KEY_SEED}           # derives the private key that encrypts stored passwords — NEVER change it after first run
      - LLDAP_LDAP_BASE_DN={{ sso_base_dn }}
      - LLDAP_LDAP_USER_PASS=${LLDAP_ADMIN_PASSWORD}   # password for the built-in `admin` user (the web UI login)
    ports:
      - {{ lldap_web_port }}:17170   # admin UI only. LDAP (3890) stays internal — Authelia and Jellyfin reach it over `homelab`.
    volumes:
      - {{ identity_appdata }}/lldap:/data
    networks:
      - homelab
    labels:                          # Glance docker-containers widget presentation
      - glance.name=LLDAP
      - glance.icon=di:openldap
      - glance.url=http://{{ vault_beelink_host }}:{{ lldap_web_port }}
      - glance.description=User directory
    restart: unless-stopped

  authelia:
    image: {{ authelia_image }}
    container_name: authelia
    depends_on:
      - lldap                        # ordering only; Authelia retries the LDAP bind on its own
    environment:
      - TZ=${TZ}
      # Secrets are NOT passed here — they are rendered straight into configuration.yml
      # (mode 0600) by Ansible. Authelia's env-var names for secrets have been renamed
      # across releases and we track :latest, so the config file is the stable surface.
    volumes:
      - {{ identity_appdata }}/authelia:/config
    networks:
      - homelab                      # NPM calls http://authelia:9091 from here; nothing is published
    labels:
      - glance.name=Authelia
      - glance.icon=di:authelia
      - glance.url=https://auth.{{ sso_domain }}
      - glance.description=SSO login portal
    restart: unless-stopped

networks:
  homelab:
    external: true                   # created by the identity role before this stack is deployed
